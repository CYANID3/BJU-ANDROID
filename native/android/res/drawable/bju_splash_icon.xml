<?xml version="1.0" encoding="utf-8"?>
<!-- Значок системной заставки (Android 12+ и библиотека совместимости): холст 288dp, кольцо 104dp по центру —
     целиком внутри круглой маски и всегда в своих пропорциях -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp"><shape android:shape="rectangle"><solid android:color="#00000000" /></shape></item>
    <item android:width="104dp" android:height="104dp" android:gravity="center" android:drawable="@drawable/bju_splash_logo" />
</layer-list>
