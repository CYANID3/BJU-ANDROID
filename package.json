{
  "name": "bju-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "build": "vite build",
    "dev": "vite",
    "android:prepare": "npm run icons && npm run build && cap add android && node scripts/android-assets.mjs && node scripts/patch-android.mjs && cap sync android",
    "cap:sync": "cap sync android",
    "test": "node --test --test-concurrency=2 \"tests/*.test.mjs\"",
    "test:all": "npm run build && npm test"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/haptics": "^7.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "playwright": "^1.56.1",
    "sharp": "^0.32.6",
    "vite": "^6.4.1"
  },
  "icon": "dark"
}
